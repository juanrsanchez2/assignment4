#include <iostream>
#include <cstdlib>
#include <cmath>
#include <ctime>
#include <iomanip>
using namespace std;

//creating const variables
const int NUM_PROCESSES = 1000;
const float QUANTUM = 2.0;
const float ARRIVAL_RATE = 2.0;
const float SERVICE_RATE = 1.0;
const float BOOST_INTERVAL = 20.0;
const int NUM_PERIODIC_TASKS = 3;
const int HYPER_PERIOD = 12;



//creating a struct called Process
struct Process {
    int id;
    float arrival_time;
    float service_time;
    float remaining_service_time;
    float start_time;
    float completion_time;
    int priority;
    float last_aging_time;
    float ready_queue_entry_time;
};

//creating a struct called PeriodicTask
struct PeriodicTask {
    int id;
    int period;
    int execution_time;
    int remaining_time;
    int next_release_time;
    int absolute_deadline;
};

//creating a struct called Event
struct Event {
    enum EventType {
        ARR,
        DEP,
        QUANTUM_EXPIRE,
        PRIORITY_BOOST
    };
    EventType type;
    float time;
    Process* process;
    Event* next;
};

//creating a function to insert events into linked-list
void addEvent(Event*& eventQueue, Event* newEvent) {
    if (eventQueue == nullptr || newEvent->time < eventQueue->time) {
        newEvent->next = eventQueue;
        eventQueue = newEvent;
        return;
    }

    Event* current = eventQueue;
    while (current->next != nullptr && current->next->time <= newEvent->time) {
        current = current->next;
    }

    newEvent->next = current->next;
    current->next = newEvent;
}

//creating a function to remove event at the front of linked-list
Event* removeEvent(Event*& eventQueue) {
    if (eventQueue == nullptr) {
        return nullptr;
    }

    Event* firstEvent = eventQueue;
    eventQueue = eventQueue->next;
    firstEvent->next = nullptr;

    return firstEvent;
}

//removing a departure event for a process that gets preempted
void removeDepartureEvent(Event*& eventQueue, Process* process) {
    Event* current = eventQueue;
    Event* previous = nullptr;

    while (current != nullptr) {
        if (current->type == Event::DEP && current->process == process) {
            if (previous == nullptr) {
                eventQueue = current->next;
            }
            else {
                previous->next = current->next;
            }

            delete current;
            return;
        }

        previous = current;
        current = current->next;
    }
}

//updating process priority after every 10 units of waiting
void updateAging(Process* process, float clock) {
    while (clock - process->last_aging_time >= 10.0 && process->priority > 1) {
        process->priority--;
        process->last_aging_time += 10.0;
    }
}

int main () {

    //seeding the random number generator
    srand(time(0));

    //creating an array to store 1000 processes
    Process originalProcesses[NUM_PROCESSES];
    Process processes[NUM_PROCESSES];


    //creating the three periodic real-time tasks
    PeriodicTask periodicTasks[NUM_PERIODIC_TASKS] = {
        {1, 4, 1, 1, 0, 4},
        {2, 6, 2, 2, 0, 6},
        {3, 12, 3, 3, 0, 12}
    };

    Event* eventQueue = nullptr;

    Process* readyQueue[NUM_PROCESSES];
    int readyFront = 0;
    int readyRear = 0;

    float clock = 0.0;
    Process* runningProcess = nullptr;


    //Assigning each process its process ID for now, using a for-loop
    for(int i = 0; i < NUM_PROCESSES; i++) {
        processes[i].id = i + 1;

        float u = (float)rand() / (RAND_MAX + 1.0);
        float interTime = log(1 - u) / ARRIVAL_RATE * -1;

        //getting interArrivalTime and absoluteArrivalTime
        if (i == 0) {
            processes[i].arrival_time = interTime;
        }
        else {
            processes[i].arrival_time = processes[i - 1].arrival_time + interTime;
        }

        //generating serviceTime and storing it in processes array
        u = (float)rand() / (RAND_MAX + 1.0);
        float serviceTime = log(1 - u) / SERVICE_RATE * -1;

        processes[i].service_time = serviceTime;
        processes[i].remaining_service_time = serviceTime; //since every process initially needs all of its service time
        processes[i].start_time = -1;                      //since the process has not been started
        processes[i].completion_time = -1;                 //since the process has not been completed

        //add comment here later-----------------------------------------------------------------------------------------
        processes[i].priority = rand() % 10 + 1;
        processes[i].last_aging_time = processes[i].arrival_time;
        processes[i].ready_queue_entry_time = processes[i].arrival_time;

        //making the arrival events
        Event* arrivalEvent = new Event;
        arrivalEvent->type = Event::ARR;
        arrivalEvent->time = processes[i].arrival_time;
        arrivalEvent->process = &processes[i];
        arrivalEvent->next = nullptr;

        addEvent(eventQueue, arrivalEvent);
    }

    //copying initial workload to originalProcesses, it will be our master copy
    for (int i = 0; i < NUM_PROCESSES; i++) {
        originalProcesses[i] = processes[i];
    }

    float lastEventTime = 0.0;
    float readyQueueArea = 0.0;

    //FCFS simulation loop
    while (eventQueue != nullptr) {
        Event* currentEvent = removeEvent(eventQueue);

        readyQueueArea += (currentEvent->time -lastEventTime) * (readyRear - readyFront);
        lastEventTime = currentEvent->time;

        clock = currentEvent->time;

        //checking if arrival of event starts immediately or goes into the queue (i.e., CPU was IDLE or BUSY)
        if (currentEvent->type == Event::ARR) {
            if (runningProcess == nullptr) {
                runningProcess = currentEvent->process;
                runningProcess->start_time = clock;

                Event* departureEvent = new Event;
                departureEvent->type = Event::DEP;
                departureEvent->time = clock + runningProcess->service_time;
                departureEvent->process = runningProcess;
                departureEvent->next = nullptr;

                addEvent(eventQueue, departureEvent);
            }
            else {
                readyQueue[readyRear] = currentEvent->process;
                readyRear++;
            }
        }
        else if (currentEvent->type == Event::DEP) {
            runningProcess->completion_time = clock;
            runningProcess = nullptr;

            if (readyFront < readyRear) {
                runningProcess = readyQueue[readyFront];
                readyFront++;

                runningProcess->start_time = clock;

                Event* departureEvent = new Event;
                departureEvent->type = Event::DEP;
                departureEvent->time = clock + runningProcess->service_time;
                departureEvent->process = runningProcess;
                departureEvent->next = nullptr;

                addEvent(eventQueue, departureEvent);
            }
        }
        //releasing dynamically allocated memory since it finished being used
        delete currentEvent;
    }

    //calculating avg turnaround time / avg waiting time / avg response time for FCFS
    float totalTurnaroundTime = 0.0;
    float totalWaitingTime = 0.0;
    float totalResponseTime = 0.0;
    float totalBusyTime = 0.0;

    for (int i = 0; i <NUM_PROCESSES; i++) {
        totalTurnaroundTime += processes[i].completion_time - processes[i].arrival_time;
        totalWaitingTime += (processes[i].completion_time - processes[i].arrival_time) - processes[i].service_time;
        totalResponseTime += processes[i].start_time - processes[i].arrival_time;
        totalBusyTime += processes[i].service_time;
    }

    float avgTurnaroundTime = totalTurnaroundTime / NUM_PROCESSES;
    float avgWaitingTime = totalWaitingTime / NUM_PROCESSES;
    float avgResponseTime = totalResponseTime / NUM_PROCESSES;
    float avgCpuUtilization = totalBusyTime / clock * 100;
    float totalCompletionTime = clock;
    float throughput = (float)NUM_PROCESSES / clock;
    float avgReadyQueueLength = readyQueueArea / clock;

    //resting process/sim for SJF
    for(int i = 0; i < NUM_PROCESSES; i++) {
        processes[i] = originalProcesses[i];

        Event* arrivalEvent = new Event;
        arrivalEvent->type = Event::ARR;
        arrivalEvent->time = processes[i].arrival_time;
        arrivalEvent->process = &processes[i];
        arrivalEvent->next = nullptr;

        addEvent(eventQueue, arrivalEvent);
    }

    readyFront = 0;
    readyRear = 0;
    clock = 0.0;
    runningProcess = nullptr;
    lastEventTime = 0.0;
    readyQueueArea = 0.0;

    //SJF sim loop
    while (eventQueue != nullptr) {
        Event* currentEvent = removeEvent(eventQueue);
        readyQueueArea += (currentEvent->time - lastEventTime) * (readyRear - readyFront);
        lastEventTime = currentEvent->time;
        clock = currentEvent->time;

        if (currentEvent->type == Event::ARR) {
            if (runningProcess == nullptr) {
                runningProcess = currentEvent->process;
                runningProcess->start_time = clock;

                Event* departureEvent = new Event;
                departureEvent->type = Event::DEP;
                departureEvent->time = clock + runningProcess->service_time;
                departureEvent->process = runningProcess;
                departureEvent->next = nullptr;

                addEvent(eventQueue, departureEvent);
            }
            else {
                readyQueue[readyRear] = currentEvent->process;
                readyRear++;
            }
        }

        else if (currentEvent->type == Event::DEP) {
            runningProcess->completion_time = clock;
            runningProcess = nullptr;

            if (readyFront < readyRear) {
                int shortestIndex = readyFront;

                for (int i = readyFront; i < readyRear; i++) {
                    if (readyQueue[i]->service_time < readyQueue[shortestIndex]->service_time) {
                        shortestIndex = i;
                    }
                    else if (readyQueue[i]->service_time == readyQueue[shortestIndex]->service_time && readyQueue[i]->id < readyQueue[shortestIndex]->id) {
                        shortestIndex = i;
                    }
                }

                Process* temp = readyQueue[readyFront];
                readyQueue[readyFront] = readyQueue[shortestIndex];
                readyQueue[shortestIndex] = temp;

                runningProcess = readyQueue[readyFront];
                readyFront++;
                runningProcess->start_time = clock;

                Event* departureEvent = new Event;
                departureEvent->type = Event::DEP;
                departureEvent->time = clock + runningProcess->service_time;
                departureEvent->process = runningProcess;
                departureEvent->next = nullptr;

                addEvent(eventQueue, departureEvent);
            }
        }

        //releasing dynamically allocated memory
        delete currentEvent;
    }

    //calculating avg turnaround time / avg waiting time / avg response time for SJF
    float sjfTotalTurnaroundTime = 0.0;
    float sjfTotalWaitingTime = 0.0;
    float sjfTotalResponseTime = 0.0;
    float sjfTotalBusyTime = 0.0;

    for (int i = 0; i < NUM_PROCESSES; i++) {
        sjfTotalTurnaroundTime += processes[i].completion_time - processes[i].arrival_time;
        sjfTotalWaitingTime += (processes[i].completion_time - processes[i].arrival_time) - processes[i].service_time;
        sjfTotalResponseTime += processes[i].start_time - processes[i].arrival_time;
        sjfTotalBusyTime += processes[i].service_time;
    }

    float sjfAvgTurnaroundTime = sjfTotalTurnaroundTime / NUM_PROCESSES;
    float sjfAvgWaitingTime = sjfTotalWaitingTime / NUM_PROCESSES;
    float sjfAvgResponseTime = sjfTotalResponseTime / NUM_PROCESSES;
    float sjfAvgCpuUtilization = sjfTotalBusyTime / clock * 100;
    float sjfTotalCompletionTime = clock;
    float sjfThroughput = (float)NUM_PROCESSES / clock;
    float sjfAvgReadyQueueLength = readyQueueArea / clock;

    //resetting process/sim for SRTF
    for(int i = 0; i < NUM_PROCESSES; i++) {
        processes[i] = originalProcesses[i];

        Event* arrivalEvent = new Event;
        arrivalEvent->type = Event::ARR;
        arrivalEvent->time = processes[i].arrival_time;
        arrivalEvent->process = &processes[i];
        arrivalEvent->next = nullptr;

        addEvent(eventQueue, arrivalEvent);
    }

    readyFront = 0;
    readyRear = 0;
    clock = 0.0;
    runningProcess = nullptr;
    lastEventTime = 0.0;
    readyQueueArea = 0.0;

    int srtfReadyCount = 0; //need since processes can enter queue more than once
    float lastStartTime = 0.0;

    //SRTF sim loop
    while (eventQueue != nullptr) {
        Event* currentEvent = removeEvent(eventQueue);

        readyQueueArea += (currentEvent->time - lastEventTime) * srtfReadyCount;
        lastEventTime = currentEvent->time;
        clock = currentEvent->time;

        if (currentEvent->type == Event::ARR) {
            if (runningProcess == nullptr) {
                runningProcess = currentEvent->process;
                runningProcess->start_time = clock;
                lastStartTime = clock;

                Event* departureEvent = new Event;
                departureEvent->type = Event::DEP;
                departureEvent->time = clock + runningProcess->remaining_service_time;
                departureEvent->process = runningProcess;
                departureEvent->next = nullptr;
                addEvent(eventQueue, departureEvent);
            }
            else {
                float timeRan = clock - lastStartTime;
                runningProcess->remaining_service_time -= timeRan;

                if (currentEvent->process->remaining_service_time < runningProcess->remaining_service_time) {
                    removeDepartureEvent(eventQueue, runningProcess);

                    readyQueue[srtfReadyCount] = runningProcess;
                    srtfReadyCount++;

                    runningProcess = currentEvent->process;
                    runningProcess->start_time = clock;
                    lastStartTime = clock;

                    Event* departureEvent = new Event;
                    departureEvent->type = Event::DEP;
                    departureEvent->time = clock + runningProcess->remaining_service_time;
                    departureEvent->process = runningProcess;
                    departureEvent->next = nullptr;

                    addEvent(eventQueue, departureEvent);
                }
                else {
                    readyQueue[srtfReadyCount] = currentEvent->process;
                    srtfReadyCount++;

                    lastStartTime = clock;
                }
            }
        }

        else if (currentEvent->type == Event::DEP) {
            runningProcess->remaining_service_time = 0.0;
            runningProcess->completion_time = clock;
            runningProcess = nullptr;

            if (srtfReadyCount > 0) {
                int shortestIndex = 0;

                for (int i = 0; i < srtfReadyCount; i++) {
                    if (readyQueue[i]->remaining_service_time < readyQueue[shortestIndex]->remaining_service_time) {
                        shortestIndex = i;
                    }
                    else if (readyQueue[i]->remaining_service_time == readyQueue[shortestIndex]->remaining_service_time && readyQueue[i]->id < readyQueue[shortestIndex]->id) {
                        shortestIndex = i;
                    }
                }

                runningProcess = readyQueue[shortestIndex];

                for (int i = shortestIndex; i < srtfReadyCount - 1; i++) {
                    readyQueue[i] = readyQueue[i + 1];
                }

                srtfReadyCount--;

                if (runningProcess->start_time == -1) {
                    runningProcess->start_time = clock;
                }

                lastStartTime = clock;

                Event* departureEvent = new Event;
                departureEvent->type = Event::DEP;
                departureEvent->time = clock + runningProcess->remaining_service_time;
                departureEvent->process = runningProcess;
                departureEvent->next = nullptr;

                addEvent(eventQueue, departureEvent);
            }
        }

        delete currentEvent;
    }

    //calculating avg turnaround time / avg waiting time / avg response time for SRTF
    float srtfTotalTurnaroundTime = 0.0;
    float srtfTotalWaitingTime = 0.0;
    float srtfTotalResponseTime = 0.0;
    float srtfTotalBusyTime = 0.0;

    for (int i = 0; i < NUM_PROCESSES; i++) {
        srtfTotalTurnaroundTime += processes[i].completion_time - processes[i].arrival_time;
        srtfTotalWaitingTime += (processes[i].completion_time - processes[i].arrival_time) - processes[i].service_time;
        srtfTotalResponseTime += processes[i].start_time - processes[i].arrival_time;
        srtfTotalBusyTime += processes[i].service_time;
    }

    float srtfAvgTurnaroundTime = srtfTotalTurnaroundTime / NUM_PROCESSES;
    float srtfAvgWaitingTime = srtfTotalWaitingTime / NUM_PROCESSES;
    float srtfAvgResponseTime = srtfTotalResponseTime / NUM_PROCESSES;
    float srtfAvgCpuUtilization = srtfTotalBusyTime / clock * 100;
    float srtfTotalCompletionTime = clock;
    float srtfThroughput = (float)NUM_PROCESSES / clock;
    float srtfAvgReadyQueueLength = readyQueueArea / clock;

    //resetting process/sim for RR
    for(int i = 0; i < NUM_PROCESSES; i++) {
        processes[i] = originalProcesses[i];

        Event* arrivalEvent = new Event;
        arrivalEvent->type = Event::ARR;
        arrivalEvent->time = processes[i].arrival_time;
        arrivalEvent->process = &processes[i];
        arrivalEvent->next = nullptr;

        addEvent(eventQueue, arrivalEvent);
    }

    readyFront = 0;
    readyRear = 0;
    clock = 0.0;
    runningProcess = nullptr;
    lastEventTime = 0.0;
    readyQueueArea = 0.0;

    int rrReadyCount = 0;

    //RR simulation loop
    while (eventQueue != nullptr) {
        Event* currentEvent = removeEvent(eventQueue);

        readyQueueArea += (currentEvent->time - lastEventTime) * rrReadyCount;
        lastEventTime = currentEvent->time;
        clock = currentEvent->time;

        if (currentEvent->type == Event::ARR) {
            if (runningProcess == nullptr) {
                runningProcess = currentEvent->process;

                if (runningProcess->start_time == -1) {
                    runningProcess->start_time = clock;
                }

                Event* nextEvent = new Event;
                if (runningProcess->remaining_service_time <= QUANTUM) {
                    nextEvent->type = Event::DEP;
                    nextEvent->time = clock + runningProcess->remaining_service_time;
                }
                else {
                    nextEvent->type = Event::QUANTUM_EXPIRE;
                    nextEvent->time = clock + QUANTUM;
                }

                nextEvent->process = runningProcess;
                nextEvent->next = nullptr;

                addEvent(eventQueue, nextEvent);

            }
            else {
                readyQueue[rrReadyCount] = currentEvent->process;
                rrReadyCount++;
            }
        }

        else if (currentEvent->type == Event::DEP) {
            runningProcess->remaining_service_time = 0.0;
            runningProcess->completion_time = clock;
            runningProcess = nullptr;

            if (rrReadyCount > 0) {
                runningProcess = readyQueue[0];

                for (int i = 0; i < rrReadyCount - 1; i++) {
                    readyQueue[i] = readyQueue[i + 1];
                }

                rrReadyCount--;

                if (runningProcess->start_time == -1) {
                    runningProcess->start_time = clock;
                }

                Event* nextEvent = new Event;

                if (runningProcess->remaining_service_time <= QUANTUM) {
                    nextEvent->type = Event::DEP;
                    nextEvent->time = clock + runningProcess->remaining_service_time;
                }
                else {
                    nextEvent->type = Event::QUANTUM_EXPIRE;
                    nextEvent->time = clock + QUANTUM;
                }

                nextEvent->process = runningProcess;
                nextEvent->next = nullptr;

                addEvent(eventQueue, nextEvent);
            }
        }
        else if (currentEvent->type == Event::QUANTUM_EXPIRE) {
            runningProcess->remaining_service_time -= QUANTUM;
            readyQueue[rrReadyCount] = runningProcess;
            rrReadyCount++;
            runningProcess = readyQueue[0];

            for (int i = 0; i < rrReadyCount - 1; i++) {
                readyQueue[i] = readyQueue[i + 1];
            }

            rrReadyCount--;

            if (runningProcess->start_time == -1) {
                runningProcess->start_time = clock;
            }

            Event* nextEvent = new Event;

            if (runningProcess->remaining_service_time <= QUANTUM) {
                nextEvent->type = Event::DEP;
                nextEvent->time = clock + runningProcess->remaining_service_time;
            }
            else {
                nextEvent->type = Event::QUANTUM_EXPIRE;
                nextEvent->time = clock + QUANTUM;
            }

            nextEvent->process = runningProcess;
            nextEvent->next = nullptr;

            addEvent(eventQueue, nextEvent);
        }

        delete currentEvent;
    }

    //calculating avg turnaround time / avg waiting time / avg response time for RR
    float rrTotalTurnaroundTime = 0.0;
    float rrTotalWaitingTime = 0.0;
    float rrTotalResponseTime = 0.0;
    float rrTotalBusyTime = 0.0;

    for (int i = 0; i < NUM_PROCESSES; i++) {
        rrTotalTurnaroundTime += processes[i].completion_time - processes[i].arrival_time;
        rrTotalWaitingTime += (processes[i].completion_time - processes[i].arrival_time) - processes[i].service_time;
        rrTotalResponseTime += processes[i].start_time - processes[i].arrival_time;
        rrTotalBusyTime += processes[i].service_time;
    }

    float rrAvgTurnaroundTime = rrTotalTurnaroundTime / NUM_PROCESSES;
    float rrAvgWaitingTime = rrTotalWaitingTime / NUM_PROCESSES;
    float rrAvgResponseTime = rrTotalResponseTime / NUM_PROCESSES;
    float rrAvgCpuUtilization = rrTotalBusyTime / clock * 100;
    float rrTotalCompletionTime = clock;
    float rrThroughput = (float)NUM_PROCESSES / clock;
    float rrAvgReadyQueueLength = readyQueueArea / clock;

    //resetting process/sim for HRRN
    for(int i = 0; i < NUM_PROCESSES; i++) {
        processes[i] = originalProcesses[i];

        Event* arrivalEvent = new Event;
        arrivalEvent->type = Event::ARR;
        arrivalEvent->time = processes[i].arrival_time;
        arrivalEvent->process = &processes[i];
        arrivalEvent->next = nullptr;

        addEvent(eventQueue, arrivalEvent);
    }

    readyFront = 0;
    readyRear = 0;
    clock = 0.0;
    runningProcess = nullptr;
    lastEventTime = 0.0;
    readyQueueArea = 0.0;

    //HRRN simulation loop
    while (eventQueue != nullptr) {
        Event* currentEvent = removeEvent(eventQueue);

        readyQueueArea += (currentEvent->time - lastEventTime) * (readyRear - readyFront);
        lastEventTime = currentEvent->time;
        clock = currentEvent->time;

        if (currentEvent->type == Event::ARR) {
            if (runningProcess == nullptr) {
                runningProcess = currentEvent->process;
                runningProcess->start_time = clock;

                Event* departureEvent = new Event;
                departureEvent->type = Event::DEP;
                departureEvent->time = clock + runningProcess->service_time;
                departureEvent->process = runningProcess;
                departureEvent->next = nullptr;

                addEvent(eventQueue, departureEvent);
            }
            else {
                readyQueue[readyRear] = currentEvent->process;
                readyRear++;
            }
        }
        else if (currentEvent->type == Event::DEP) {
            runningProcess->completion_time = clock;
            runningProcess = nullptr;

            if (readyFront < readyRear) {
                int highestIndex = readyFront;
                float highestRatio = 0.0;

                for (int i = readyFront; i < readyRear; i++) {
                    float waitingTime = clock - readyQueue[i]->arrival_time;
                    float responseRatio = (waitingTime + readyQueue[i]->service_time) / readyQueue[i]->service_time;

                    if (responseRatio > highestRatio) {
                        highestRatio = responseRatio;
                        highestIndex = i;
                    }
                    else if (responseRatio == highestRatio && readyQueue[i]->id < readyQueue[highestIndex]->id) {
                        highestIndex = i;
                    }
                }

                Process* temp = readyQueue[readyFront];
                readyQueue[readyFront] = readyQueue[highestIndex];
                readyQueue[highestIndex] = temp;

                runningProcess = readyQueue[readyFront];
                readyFront++;

                runningProcess->start_time = clock;

                Event* departureEvent = new Event;
                departureEvent->type = Event::DEP;
                departureEvent->time = clock + runningProcess->service_time;
                departureEvent->process = runningProcess;
                departureEvent->next = nullptr;

                addEvent(eventQueue, departureEvent);
            }
        }

        delete currentEvent;
    }

    //calculating avg turnaround time / avg waiting time / avg response time for HRRN
    float hrrnTotalTurnaroundTime = 0.0;
    float hrrnTotalWaitingTime = 0.0;
    float hrrnTotalResponseTime = 0.0;
    float hrrnTotalBusyTime = 0.0;

    for (int i = 0; i < NUM_PROCESSES; i++) {
        hrrnTotalTurnaroundTime += processes[i].completion_time - processes[i].arrival_time;
        hrrnTotalWaitingTime += (processes[i].completion_time - processes[i].arrival_time) - processes[i].service_time;
        hrrnTotalResponseTime += processes[i].start_time - processes[i].arrival_time;
        hrrnTotalBusyTime += processes[i].service_time;
    }

    float hrrnAvgTurnaroundTime = hrrnTotalTurnaroundTime / NUM_PROCESSES;
    float hrrnAvgWaitingTime = hrrnTotalWaitingTime / NUM_PROCESSES;
    float hrrnAvgResponseTime = hrrnTotalResponseTime / NUM_PROCESSES;
    float hrrnAvgCpuUtilization = hrrnTotalBusyTime / clock * 100;
    float hrrnTotalCompletionTime = clock;
    float hrrnThroughput = (float)NUM_PROCESSES / clock;
    float hrrnAvgReadyQueueLength = readyQueueArea / clock;

    //resetting process/sim for Priority Scheduling with Aging
    for (int i = 0; i < NUM_PROCESSES; i++) {
        processes[i] = originalProcesses[i];

        Event* arrivalEvent = new Event;
        arrivalEvent->type = Event::ARR;
        arrivalEvent->time = processes[i].arrival_time;
        arrivalEvent->process = &processes[i];
        arrivalEvent->next = nullptr;

        addEvent(eventQueue, arrivalEvent);
    }

    readyFront = 0;
    readyRear = 0;
    clock = 0.0;
    runningProcess = nullptr;
    lastEventTime = 0.0;
    readyQueueArea = 0.0;

    //Priority Scheduling with Aging sim loop
    while (eventQueue != nullptr) {
        Event* currentEvent = removeEvent(eventQueue);

        readyQueueArea += (currentEvent->time - lastEventTime) * (readyRear - readyFront);
        lastEventTime = currentEvent->time;
        clock = currentEvent->time;

        if (currentEvent->type == Event::ARR) {
            if (runningProcess == nullptr) {
                runningProcess = currentEvent->process;
                runningProcess->start_time = clock;

                Event* departureEvent = new Event;
                departureEvent->type = Event::DEP;
                departureEvent->time = clock + runningProcess->service_time;
                departureEvent->process = runningProcess;
                departureEvent->next = nullptr;

                addEvent(eventQueue, departureEvent);
            }
            else {
                currentEvent->process->ready_queue_entry_time = clock;
                currentEvent->process->last_aging_time = clock;
                readyQueue[readyRear] = currentEvent->process;
                readyRear++;
            }
        }
        else if (currentEvent->type == Event::DEP) {
            runningProcess->completion_time = clock;
            runningProcess = nullptr;

            if (readyFront < readyRear) {
                int highestIndex = readyFront;

                //apply aging to all waiting processes
                for (int i = readyFront; i < readyRear; i++) {
                    updateAging(readyQueue[i], clock);
                }

                //find the process with the highest priority
                for (int i = readyFront; i < readyRear; i++) {
                    if (readyQueue[i]->priority < readyQueue[highestIndex]->priority) {
                        highestIndex = i;
                    }
                    else if (readyQueue[i]->priority == readyQueue[highestIndex]->priority && readyQueue[i]->id < readyQueue[highestIndex]->id) {
                        highestIndex = i;
                    }
                }

                Process* temp = readyQueue[readyFront];
                readyQueue[readyFront] = readyQueue[highestIndex];
                readyQueue[highestIndex] = temp;

                runningProcess = readyQueue[readyFront];
                readyFront++;
                runningProcess->start_time = clock;

                Event* departureEvent = new Event;
                departureEvent->type = Event::DEP;
                departureEvent->time = clock + runningProcess->service_time;
                departureEvent->process = runningProcess;
                departureEvent->next = nullptr;

                addEvent(eventQueue, departureEvent);
            }
        }

        delete currentEvent;
    }

    //calculating Priority Scheduling with Aging performance metrics
    float priorityTotalTurnaroundTime = 0.0;
    float priorityTotalWaitingTime = 0.0;
    float priorityTotalResponseTime = 0.0;
    float priorityTotalBusyTime = 0.0;
    float priorityMaxWaitingTime = 0.0;

    for (int i = 0; i < NUM_PROCESSES; i++) {
        float turnaroundTime = processes[i].completion_time - processes[i].arrival_time;
        float waitingTime = turnaroundTime - processes[i].service_time;
        float responseTime = processes[i].start_time - processes[i].arrival_time;

        priorityTotalTurnaroundTime += turnaroundTime;
        priorityTotalWaitingTime += waitingTime;
        priorityTotalResponseTime += responseTime;
        priorityTotalBusyTime += processes[i].service_time;

        if (waitingTime > priorityMaxWaitingTime) {
            priorityMaxWaitingTime = waitingTime;
        }
    }

    float priorityTotalCompletionTime = clock;
    float priorityAvgTurnaroundTime = priorityTotalTurnaroundTime / NUM_PROCESSES;
    float priorityAvgWaitingTime = priorityTotalWaitingTime / NUM_PROCESSES;
    float priorityAvgResponseTime = priorityTotalResponseTime / NUM_PROCESSES;
    float priorityAvgCpuUtilization = priorityTotalBusyTime / clock * 100;

    //resetting process/sim for MLFQ
    for (int i = 0; i < NUM_PROCESSES; i++) {
        processes[i] = originalProcesses[i];

        Event* arrivalEvent = new Event;
        arrivalEvent->type = Event::ARR;
        arrivalEvent->time = processes[i].arrival_time;
        arrivalEvent->process = &processes[i];
        arrivalEvent->next = nullptr;

        addEvent(eventQueue, arrivalEvent);
    }

    readyFront = 0;
    readyRear = 0;
    clock = 0.0;
    runningProcess = nullptr;
    lastEventTime = 0.0;
    readyQueueArea = 0.0;

    //creating two ready queues for MLFQ
    Process* queue0[NUM_PROCESSES];
    Process* queue1[NUM_PROCESSES];
    int queue0Count = 0;
    int queue1Count = 0;

    //tracking when the current process begins running
    float mlfqLastStartTime = 0.0;

    int runningQueue = -1;
    int mlfqCompleted = 0;

    //scheduling the first priority boost
    Event* boostEvent = new Event;
    boostEvent->type = Event::PRIORITY_BOOST;
    boostEvent->time = BOOST_INTERVAL;
    boostEvent->process = nullptr;
    boostEvent->next = nullptr;

    addEvent(eventQueue, boostEvent);

    //MLFQ sim loop
    while (eventQueue != nullptr && mlfqCompleted < NUM_PROCESSES) {
        Event* currentEvent = removeEvent(eventQueue);

        //processing CPU events before a simultaneous priority boost
        if (currentEvent->type == Event::PRIORITY_BOOST) {
            Event* previous = nullptr;
            Event* current = eventQueue;

            while (current != nullptr && current->time == currentEvent->time) {
                if (current->type == Event::DEP || current->type == Event::QUANTUM_EXPIRE || current->type == Event::ARR) {
                    if (previous == nullptr) {
                        eventQueue = current->next;
                    }
                    else {
                        previous->next = current->next;
                    }

                    Event* cpuEvent = current;
                    Event* boostPosition = eventQueue;
                    Event* previousBoostPosition = nullptr;

                    while (boostPosition != nullptr && boostPosition->time == currentEvent->time) {
                        previousBoostPosition = boostPosition;
                        boostPosition = boostPosition->next;
                    }

                    if (previousBoostPosition == nullptr) {
                        currentEvent->next = eventQueue;
                        eventQueue = currentEvent;
                    }
                    else {
                        currentEvent->next = boostPosition;
                        previousBoostPosition->next = currentEvent;
                    }
                    currentEvent = cpuEvent;
                    currentEvent->next = nullptr;
                    break;
                }

                previous = current;
                current = current->next;
            }
        }

        readyQueueArea += (currentEvent->time - lastEventTime) * (queue0Count + queue1Count);
        lastEventTime = currentEvent->time;
        clock = currentEvent->time;

        if (currentEvent->type == Event::ARR) {
            //all new processes enter Q0
            queue0[queue0Count] = currentEvent->process;
            queue0Count++;

            if (runningProcess == nullptr) {
                runningProcess = queue0[0];

                for (int i = 0; i < queue0Count - 1; i++) {
                    queue0[i] = queue0[i + 1];
                }

                queue0Count--;
                runningQueue = 0;
                mlfqLastStartTime = clock;

                if (runningProcess->start_time == -1) {
                    runningProcess->start_time = clock;
                }

                Event* nextEvent = new Event;

                if (runningProcess->remaining_service_time <= QUANTUM) {
                    nextEvent->type = Event::DEP;
                    nextEvent->time = clock + runningProcess->remaining_service_time;
                }
                else {
                    nextEvent->type = Event::QUANTUM_EXPIRE;
                    nextEvent->time = clock + QUANTUM;
                }

                nextEvent->process = runningProcess;
                nextEvent->next = nullptr;

                addEvent(eventQueue, nextEvent);
            }

            //preempt Q1 when a new process arrives in Q0
            else if (runningQueue == 1) {
                float timeRan = clock - mlfqLastStartTime;
                runningProcess->remaining_service_time -= timeRan;

                removeDepartureEvent(eventQueue, runningProcess);

                //returning the interrupted process to the front of Q1
                for (int i = queue1Count; i > 0; i--) {
                    queue1[i] = queue1[i - 1];
                }

                queue1[0] = runningProcess;
                queue1Count++;

                //selecting the first process from Q0
                runningProcess = queue0[0];

                for (int i = 0; i < queue0Count - 1; i++) {
                    queue0[i] = queue0[i + 1];
                }

                queue0Count--;
                runningQueue = 0;
                mlfqLastStartTime = clock;

                if (runningProcess->start_time == -1) {
                    runningProcess->start_time = clock;
                }

                Event* nextEvent = new Event;

                if (runningProcess->remaining_service_time <= QUANTUM) {
                    nextEvent->type = Event::DEP;
                    nextEvent->time = clock + runningProcess->remaining_service_time;
                }
                else {
                    nextEvent->type = Event::QUANTUM_EXPIRE;
                    nextEvent->time = clock + QUANTUM;
                }

                nextEvent->process = runningProcess;
                nextEvent->next = nullptr;

                addEvent(eventQueue, nextEvent);
            }

        }

        //handling Q0 quantum expiration
        else if (currentEvent->type == Event::QUANTUM_EXPIRE) {
            runningProcess->remaining_service_time -= QUANTUM;

            //demoting the unfinished process to Q1
            queue1[queue1Count] = runningProcess;
            queue1Count++;
            runningProcess = nullptr;
            runningQueue = -1;

            //Q0 always has priority over Q1
            if (queue0Count > 0) {
                runningProcess = queue0[0];

                for (int i = 0; i < queue0Count - 1; i++) {
                    queue0[i] = queue0[i + 1];
                }

                queue0Count--;
                runningQueue = 0;
            }
            else if (queue1Count > 0) {
                runningProcess = queue1[0];

                for (int i = 0; i < queue1Count - 1; i++) {
                    queue1[i] = queue1[i + 1];
                }

                queue1Count--;
                runningQueue = 1;
            }

            if (runningProcess != nullptr) {
                if (runningProcess->start_time == -1) {
                    runningProcess->start_time = clock;
                }

                mlfqLastStartTime = clock;

                Event* nextEvent = new Event;

                if (runningQueue == 0 && runningProcess->remaining_service_time > QUANTUM) {
                    nextEvent->type = Event::QUANTUM_EXPIRE;
                    nextEvent->time = clock + QUANTUM;
                }
                else {
                    nextEvent->type = Event::DEP;
                    nextEvent->time = clock + runningProcess->remaining_service_time;
                }

                nextEvent->process = runningProcess;
                nextEvent->next = nullptr;

                addEvent(eventQueue, nextEvent);
            }
        }

        //handling process completion in MLFQ
        else if (currentEvent->type == Event::DEP) {
            runningProcess->remaining_service_time = 0.0;
            runningProcess->completion_time = clock;
            mlfqCompleted++;

            runningProcess = nullptr;
            runningQueue = -1;

            //Q0 has priority over Q1
            if (queue0Count > 0) {
                runningProcess = queue0[0];

                for (int i = 0; i < queue0Count - 1; i++) {
                    queue0[i] = queue0[i + 1];
                }

                queue0Count--;
                runningQueue = 0;
            }
            else if (queue1Count > 0) {
                runningProcess = queue1[0];

                for (int i = 0; i < queue1Count - 1; i++) {
                    queue1[i] = queue1[i + 1];
                }

                queue1Count--;
                runningQueue = 1;
            }

            if (runningProcess != nullptr) {
                if (runningProcess->start_time == -1) {
                    runningProcess->start_time = clock;
                }

                mlfqLastStartTime = clock;

                Event* nextEvent = new Event;

                if (runningQueue == 0 && runningProcess->remaining_service_time > QUANTUM) {
                    nextEvent->type = Event::QUANTUM_EXPIRE;
                    nextEvent->time = clock + QUANTUM;
                }
                else {
                    nextEvent->type = Event::DEP;
                    nextEvent->time = clock + runningProcess->remaining_service_time;
                }

                nextEvent->process = runningProcess;
                nextEvent->next = nullptr;

                addEvent(eventQueue, nextEvent);
            }
        }

        //handling MLFQ priority boosts
        else if (currentEvent->type == Event::PRIORITY_BOOST) {
            //promoting all waiting Q1 processes into Q0
            for (int i = 0; i < queue1Count; i++) {
                queue0[queue0Count] = queue1[i];
                queue0Count++;
            }

            queue1Count = 0;

            //handling a process currently running in Q1
            if (runningProcess != nullptr && runningQueue == 1) {
                float timeRan = clock - mlfqLastStartTime;
                runningProcess->remaining_service_time -= timeRan;

                removeDepartureEvent(eventQueue, runningProcess);

                queue0[queue0Count] = runningProcess;
                queue0Count++;

                runningProcess = nullptr;
                runningQueue = -1;
            }

            //selecting a Q0 process if the CPU is idle
            if (runningProcess == nullptr && queue0Count > 0) {
                runningProcess = queue0[0];

                for (int i = 0; i < queue0Count - 1; i++) {
                    queue0[i] = queue0[i + 1];
                }

                queue0Count--;
                runningQueue = 0;
                mlfqLastStartTime = clock;

                if (runningProcess->start_time == -1) {
                    runningProcess->start_time = clock;
                }

                Event* nextEvent = new Event;

                if (runningProcess->remaining_service_time <= QUANTUM) {
                    nextEvent->type = Event::DEP;
                    nextEvent->time = clock + runningProcess->remaining_service_time;
                }
                else {
                    nextEvent->type = Event::QUANTUM_EXPIRE;
                    nextEvent->time = clock + QUANTUM;
                }

                nextEvent->process = runningProcess;
                nextEvent->next = nullptr;

                addEvent(eventQueue, nextEvent);
            }

            //scheduling the next priority boost if processes remain
            if (mlfqCompleted < NUM_PROCESSES) {
                Event* nextBoost = new Event;
                nextBoost->type = Event::PRIORITY_BOOST;
                nextBoost->time = clock + BOOST_INTERVAL;
                nextBoost->process = nullptr;
                nextBoost->next = nullptr;

                addEvent(eventQueue, nextBoost);
            }
        }

        delete currentEvent;
    }

    //dealing remaining MLFQ events
    while (eventQueue != nullptr) {
        Event* remainingEvent = removeEvent(eventQueue);
        delete remainingEvent;
    }

    //calculating MLFQ performance metrics
    float mlfqTotalTurnaroundTime = 0.0;
    float mlfqTotalWaitingTime = 0.0;
    float mlfqTotalResponseTime = 0.0;
    float mlfqTotalBusyTime = 0.0;
    float mlfqMaxWaitingTime = 0.0;

    for (int i = 0; i < NUM_PROCESSES; i++) {
        float turnaroundTime = processes[i].completion_time - processes[i].arrival_time;
        float waitingTime = turnaroundTime - processes[i].service_time;
        float responseTime = processes[i].start_time - processes[i].arrival_time;

        mlfqTotalTurnaroundTime += turnaroundTime;
        mlfqTotalWaitingTime += waitingTime;
        mlfqTotalResponseTime += responseTime;
        mlfqTotalBusyTime += processes[i].service_time;

        if (waitingTime > mlfqMaxWaitingTime) {
            mlfqMaxWaitingTime = waitingTime;
        }
    }

    float mlfqTotalCompletionTime = clock;
    float mlfqAvgTurnaroundTime = mlfqTotalTurnaroundTime / NUM_PROCESSES;
    float mlfqAvgWaitingTime = mlfqTotalWaitingTime / NUM_PROCESSES;
    float mlfqAvgResponseTime = mlfqTotalResponseTime / NUM_PROCESSES;
    float mlfqAvgCpuUtilization = mlfqTotalBusyTime / clock * 100;

    //RM scheduling simulation
    PeriodicTask rmTasks[NUM_PERIODIC_TASKS];

    for (int i = 0; i < NUM_PERIODIC_TASKS; i++) {
        rmTasks[i] = periodicTasks[i];
    }

    int rmDeadlineMisses = 0;
    int rmCompletedJobs = 0;

    //sim the 12 ms hyperperiod
    for (int time = 0; time < HYPER_PERIOD; time++) {

        //release new periodic jobs
        for (int i = 0; i < NUM_PERIODIC_TASKS; i++) {
            if (time == rmTasks[i].next_release_time) {
                rmTasks[i].remaining_time = rmTasks[i].execution_time;
                rmTasks[i].absolute_deadline = time + rmTasks[i].period;
                rmTasks[i].next_release_time += rmTasks[i].period;
            }
        }

        //select the ready task with the shortest period
        int highestPriorityIndex = -1;

        for (int i = 0; i < NUM_PERIODIC_TASKS; i++) {
            if (rmTasks[i].remaining_time > 0) {
                if (highestPriorityIndex == -1 || rmTasks[i].period < rmTasks[highestPriorityIndex].period) {
                    highestPriorityIndex = i;
                }
            }
        }

        //execute the highest-priority task for 1 ms
        if (highestPriorityIndex != -1) {
            rmTasks[highestPriorityIndex].remaining_time--;

            if (rmTasks[highestPriorityIndex].remaining_time == 0) {
                rmCompletedJobs++;
            }
        }

        //check for missed deadlines
        for (int i = 0; i < NUM_PERIODIC_TASKS; i++) {
            if (time + 1 == rmTasks[i].absolute_deadline && rmTasks[i].remaining_time > 0) {
                rmDeadlineMisses++;
            }
        }
    }

    bool rmAllDeadlinesMet = (rmDeadlineMisses == 0);

    //EDF scheduling sim loop
    PeriodicTask edfTasks[NUM_PERIODIC_TASKS];

    for (int i = 0; i < NUM_PERIODIC_TASKS; i++) {
        edfTasks[i] = periodicTasks[i];
    }

    int edfDeadlineMisses = 0;
    int edfCompletedJobs = 0;

    //simulate the 12 ms hyperperiod
    for (int time = 0; time < HYPER_PERIOD; time++) {

        //release new periodic jobs
        for (int i = 0; i < NUM_PERIODIC_TASKS; i++) {
            if (time == edfTasks[i].next_release_time) {
                edfTasks[i].remaining_time = edfTasks[i].execution_time;
                edfTasks[i].absolute_deadline = time + edfTasks[i].period;
                edfTasks[i].next_release_time += edfTasks[i].period;
            }
        }

        //select the ready task with the earliest absolute deadline
        int earliestDeadlineIndex = -1;

        for (int i = 0; i < NUM_PERIODIC_TASKS; i++) {
            if (edfTasks[i].remaining_time > 0) {
                if (earliestDeadlineIndex == -1 || edfTasks[i].absolute_deadline < edfTasks[earliestDeadlineIndex].absolute_deadline) {
                    earliestDeadlineIndex = i;
                }
            }
        }

        //execute the selected task for 1 ms
        if (earliestDeadlineIndex != -1) {
            edfTasks[earliestDeadlineIndex].remaining_time--;

            if (edfTasks[earliestDeadlineIndex].remaining_time == 0) {
                edfCompletedJobs++;
            }
        }

        //check for missed deadlines
        for (int i = 0; i < NUM_PERIODIC_TASKS; i++) {
            if (time + 1 == edfTasks[i].absolute_deadline && edfTasks[i].remaining_time > 0) {
                edfDeadlineMisses++;
            }
        }
    }

    bool edfAllDeadlinesMet = (edfDeadlineMisses == 0);

    //calculating real-time task utilization and schedulability bounds
    float totalUtilization = 0.0;

    for (int i = 0; i < NUM_PERIODIC_TASKS; i++) {
        totalUtilization += (float)periodicTasks[i].execution_time / periodicTasks[i].period;
    }

    float rmSchedulabilityBound = NUM_PERIODIC_TASKS * (pow(2.0, 1.0 / NUM_PERIODIC_TASKS) - 1);
    float edfSchedulabilityBound = 1.0;

    //Part 1 performance comparison table
    cout << endl;
    cout << "### CS 3360 Assignment 4 Part 1: Advanced Schedulers Summary (1000 Processes)" << endl;
    cout << endl;

    cout << left << setw(36) << "Metric"
         << "| " << setw(27) << "Priority with Aging"
         << "| " << "MLFQ (Boost S=20ms)" << endl;

    cout << "-----------------------------------------------------------------------------------------------" << endl;

    cout << left << fixed << setprecision(3);

    cout << setw(36) << "Total Completion Time (ms)"
         << "| " << priorityTotalCompletionTime << " ms"
         << setw(16) << " "
         << "| " << mlfqTotalCompletionTime << " ms" << endl;

    cout << setw(36) << "Average Turnaround Time (ms)"
         << "| " << priorityAvgTurnaroundTime << " ms"
         << setw(17) << " "
         << "| " << mlfqAvgTurnaroundTime << " ms" << endl;

    cout << setw(36) << "Average Waiting Time (ms)"
         << "| " << priorityAvgWaitingTime << " ms"
         << setw(17) << " "
         << "| " << mlfqAvgWaitingTime << " ms" << endl;

    cout << setw(36) << "Average Response Time (ms)"
         << "| " << priorityAvgResponseTime << " ms"
         << setw(17) << " "
         << "| " << mlfqAvgResponseTime << " ms" << endl;

    cout << setw(36) << "Overall CPU Utilization (%)"
         << "| " << priorityAvgCpuUtilization << "%"
         << setw(19) << " "
         << " | " << mlfqAvgCpuUtilization << "%" << endl;

    cout << setw(36) << "Maximum Waiting Time (ms)"
         << "| " << priorityMaxWaitingTime << " ms"
         << setw(17) << " "
         << "| " << mlfqMaxWaitingTime << " ms" << endl;

    //Part 2 real-time schedulers summary
    cout << endl;
    cout << "### Part 2: Real-Time Schedulers Summary (Hyper-Period = 12 ms)" << endl;
    cout << endl;

    cout << left << setw(40) << "Metric"
         << "| " << setw(27) << "Rate-Monotonic (RM)"
         << "| " << "Earliest-Deadline-First (EDF)" << endl;

    cout << "----------------------------------------------------------------------------------------------------" << endl;

    cout << fixed << setprecision(2);

    cout << setw(40) << "Total Utilization (%)"
         << "| " << totalUtilization * 100 << "%"
         << setw(21) << " "
         << "| " << totalUtilization * 100 << "%" << endl;

    cout << setw(40) << "Theoretical Schedulability Bound (%)"
         << "| " << rmSchedulabilityBound * 100 << "%"
         << setw(21) << " "
         << "| " << edfSchedulabilityBound * 100 << "%" << endl;

    cout << setw(40) << "All Deadlines Met? (Yes/No)"
         << "| " << setw(27) << (rmAllDeadlinesMet ? "Yes" : "No")
         << "| " << (edfAllDeadlinesMet ? "Yes" : "No") << endl;

    cout << setw(40) << "Total Deadline Misses"
         << "| " << setw(27) << rmDeadlineMisses
         << "| " << edfDeadlineMisses << endl;

    return 0;
}
